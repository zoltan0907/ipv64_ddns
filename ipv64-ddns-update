#!/usr/bin/env bash
# set -x
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
APIKEY=""
DOMAIN=""
LOGAPIKEY=""
LOCALCONFIG=""
DNSOKIPV4=1
DNSOKIPV6=1
DNSOVERTLS=""
DNSQUERY=""

SCRIPTVERSION=$(dpkg -l | grep ipv64-ipv64-ddns-update | sed 's/ //g' | cut -d "e" -f2 | cut -d "a" -f1)
CURLCLIENT="ipv64-ipv64-ddns-update/$SCRIPTVERSION gitlab.com/playdiver/ipv64-ddns-update"


function log() {
	STIMESTEMP=$(date +%Y-%m-%d\ %H:%M:%S)
	LOGFILE=$(date +%Y-%m-%d)
	echo "$STIMESTEMP | [$2] | $1"
	echo "$STIMESTEMP | [$2] | $1" >> /var/log/ipv64-ddns-update/ipv64_ddns_update_"$LOGFILE".log
}


function GetIPv4 () {
    IPv4=$(curl --user-agent "$CURLCLIENT" $CURL_OPTIONS -4s https://ipv64.net/nic/update\?howismyip | jq '.ip' | cut -d '"' -f2)
    echo "$IPv4"
}


function GetIPv6 () {
    IPv6=$(curl --user-agent "$CURLCLIENT" $CURL_OPTIONS -6s https://ipv64.net/nic/update\?howismyip | jq '.ip' | cut -d '"' -f2)
    echo "$IPv6"
}


function Check_DNSv6 () {
	DNSA=$(dig "$DNSQUERY" "$1" AAAA @ns1.ipv64.net)
	echo "$DNSA"
}


function Check_DNSv4 () {
	DNSA=$(dig "$DNSQUERY" "$1" A @ns1.ipv64.net)
	echo "$DNSA"
}


function CheckAPIAUTH () {
		IP=$(GetIPv4)
		if [ "$(curl --user-agent "$CURLCLIENT" $CURL_OPTIONS -4sSL "https://ipv64.net/update.php?key=${APIKEY}&domain=${DOMAIN}&ip=${IP}" | grep -o "success")" == "success" ] ; then	
			log "Die Angaben sind richtig gesetzt: DOMAIN und DOMAIN KEY" "API-AUTH"
			sha256sum "$LOCALCONFIG"/config.cfg | cut -d " " -f1 > "$LOCALCONFIG"/.config.cfg
		else
    			log "Die Angaben sind falsch  gesetzt: DOMAIN oder DOMAIN KEY" "API-AUTH"
    			exit 1
		fi

}


function CheckDATEN () {
	if [ -f /etc/ipv64-ddns-update/config.cfg ];then
		LOCALCONFIG=/etc/ipv64-ddns-update/
		log "Es befindet sich eine Config unter /etc diese wird nun benutzt" "CONFIG"
	elif [ -f config.cfg ];then
		log "Es existiert keine globale Config. Die Config im Ordner wird benutzt" "CONFIG"
		LOCALCONFIG=$(pwd)
	else
		log "Bitte rufe 'ipv64-ddns-update -set' auf und folge den Anweisungen" "CONFIG"
		exit 1
	fi
	
	
	if [ -f "$LOCALCONFIG"/.config.cfg ]; then
		hash1=$(cat "$LOCALCONFIG"/.config.cfg)
		hash2=$(sha256sum "$LOCALCONFIG"/config.cfg | cut -d ' ' -f1)
		if [ "$hash1" != "$hash2" ]; then
			log "API Zugriff wird geprüft" "API-Zugriff"
		fi
	else
		log "API Zugriff wird geprüft" "API-Zugriff"
	fi

	if [ -f "$LOCALCONFIG"/config.cfg ]; then
		APIKEY=$(grep APIKEY "$LOCALCONFIG"/config.cfg | cut -d "=" -f2)
		DOMAIN=$(grep DOMAIN "$LOCALCONFIG"/config.cfg | cut -d "=" -f2)	
		IPv6AKTIV=$(grep IPv6AKTIV "$LOCALCONFIG"/config.cfg | cut -d "=" -f2)
		IPv4AKTIV=$(grep IPv4AKTIV "$LOCALCONFIG"/config.cfg | cut -d "=" -f2)
		DNSOVERTLS=$(grep DNSOVERTLS "$LOCALCONFIG"/config.cfg | cut -d "=" -f2)
		APIKEYSTART="${APIKEY:0:5}"
		APIKEYEND=$(echo "$APIKEY" | awk '{print substr($0, length($0)-4,5)}')
		LOGAPIKEY="$APIKEYSTART**************"$APIKEYEND	
		log "Hinterlegter API-KEY: $LOGAPIKEY" "CONFIG"
		log "Hinterlegte DOMAIN  : $DOMAIN" "CONFIG"
		if [ -z "$APIKEY" ]; then
			log "Es konnte kein API-Key gefunden werden" "CONFIG"
			exit 1
		fi

		if [ -z "$DOMAIN" ]; then
			log "Es konnte keine Domain gefunden werden" "CONFIG"
			exit 1
		fi

		if [ -z "$IPv6AKTIV" ]; then
			log "Es wurde nicht eingestellt, ob IPv6 aktiv oder deaktiviert sein soll" "CONFIG"
			exit 1
		fi

		if [ -z "$IPv4AKTIV" ]; then
			log "Es wurde nicht eingestellt, ob IPv4 aktiv oder deaktiviert sein soll" "CONFIG"
			exit 1
		fi

		if [ -z "$DNSOVERTLS" ]; then
			log "Es wurde nicht eingestellt, ob DNSoverTLS aktiv oder deaktiviert sein soll, default ist False" "CONFIG"
			echo "DNSOVERTLS=False" >> /etc/ipv64-ddns-update/config.cfg
		fi
	else
		log "Es konnte keine config.cfg gefunden werden" "CONFIG"
		log "Bitte rufe 'ipv64-ddns-update -set' auf und folge den Anweisungen" "CONFIG"
		exit 1
	fi
	
	if [ -f "$LOCALCONFIG"/.config.cfg ]; then
		hash1=$(cat "$LOCALCONFIG"/.config.cfg)
		hash2=$(sha256sum "$LOCALCONFIG"/config.cfg | cut -d ' ' -f1)
		if [ "$hash1" != "$hash2" ]; then
			log "API Zugriff wird geprüft" "API-Zugriff"
			CheckAPIAUTH
		else
			log "API Zugriff wurde schon geprüft" "API-Zugriff"
		fi
	else
		log "API Zugriff wird geprüft" "API-Zugriff"
		CheckAPIAUTH
	fi
}	


function CheckUpdateDNSIPv4 () {
	
	if [ "$1" == "$2" ]; then
		if [ "$DNSOKIPV4" == 1 ];then
		log "DNS OK" "IPv4"
		DNSOKIPV4=0
		fi
	else
		log "Die IPv4 wird nun für die Domain $DOMAIN hinterlegt" "IPv4"
		UpdateDNS_IPv4
		DNSOKIPV4=1
	fi	

}


function CheckUpdateDNSIPv6 () {
	if [ "$1" == "$2" ]; then
		if [ "$DNSOKIPV6" == 1 ];then
		log "DNS OK" "IPv6"
		DNSOKIPV6=0
		fi
	else

		log "Die IPv6 wird nun für die Domain $DOMAIN hinterlegt" "IPv6"
		UpdateDNS_IPv6
		DNSOKIPV6=1
	fi	

}



function UpdateDNS_IPv4() {
	curl --user-agent "$CURLCLIENT" $CURL_OPTIONS -4sSL "https://ipv64.net/nic/update?key=${APIKEY}&domain=${DOMAIN}&ip=$(GetIPv4)" > /dev/null
	log "--user-agent $CURLCLIENT $CURL_OPTIONS https://ipv64.net/nic/update?key=${LOGAPIKEY}&domain=${DOMAIN}&ip=$(GetIPv4)" "DNS-Update"
}


function UpdateDNS_IPv6() {
	curl --user-agent "$CURLCLIENT" $CURL_OPTIONS -6sSL "https://ipv64.net/nic/update?key=${APIKEY}&domain=${DOMAIN}&ip6=$(GetIPv6)" > /dev/null
	log "--user-agent $CURLCLIENT $CURL_OPTIONS https://ipv64.net/nic/update?key=${LOGAPIKEY}&domain=${DOMAIN}&ip6=$(GetIPv6)" "DNS-Update"
}


function main()
{

	if [ "$IPv6AKTIV" == True ]; then
	DNSIPv6=$(Check_DNSv6 "$DOMAIN")
	IPv6=$(GetIPv6)
	CheckUpdateDNSIPv6 "$IPv6" "$DNSIPv6"
	fi

	if [ "$IPv4AKTIV" == True ]; then
	DNSIPv4=$(Check_DNSv4 "$DOMAIN")
	IPv4=$(GetIPv4)
	CheckUpdateDNSIPv4 "$IPv4" "$DNSIPv4"
	fi
}


function set() {
	clear
	echo -n "Gebe deine DDNS-Adresse ein: "
	read -r DOMAIN
	clear
	echo -n "Gebe dein Updatehash ein: "
	read -r APIKEY
	clear
	echo -n "IPv4 False oder True - Bitte genau auf Groß- /Kleinschreibung achten:  "
	read -r IPv4
	clear
	echo -n "IPv6 False oder True - Bitte genau auf Groß- /Kleinschreibung achten:  "
	read -r IPv6
	clear
	echo -n "DNSoverTLS False oder True - Bitte genau auf Groß- /Kleinschreibung achten:  "
	read -r DNSOVERTLS
	clear
	if dpkg -l | grep ipv64-ipv64-ddns-update ;then
		clear
		STIMESTEMP=$(date +%Y-%m-%d\ %H:%M:%S)
		echo -e "# Datei wurde am $STIMESTEMP erzeugt\\nAPIKEY=$APIKEY\\nDOMAIN=$DOMAIN\\nIPv4AKTIV=$IPv4\\nIPv6AKTIV=$IPv6" > /etc/ipv64-ddns-update/config.cfg	
		
		
		exit 0
	fi
	clear
	echo -e "# Datei wurde am $STIMESTEMP erzeugt\\nAPIKEY=$APIKEY\\nDOMAIN=$DOMAIN\\nIPv4AKTIV=$IPv4\\nIPv6AKTIV=$IPv6" > config.cfg	
	exit 0
}

function run() {
	
	log "Script wird gestartet" "SCRIPT"
	log "Das Script läuft unter der PID: $$" "SCRIPT"
	log "Das Debian Paket läuft in der Version  $SCRIPTVERSION auf den Server" "SCRIPT"
	echo $$ > /tmp/ipv64-ddns-update.pid
	CheckDATEN
	TLSVERFUEGBAR=$(dig -h | grep DNS-over-TLS)
	if [ -n "$TLSVERFUEGBAR" ] && [ "$DNSOVERTLS" == True ]; then
		DNSQUERY="+short +tls"
	else
		DNSQUERY="+short"
	fi
	while true
	do
		main
		sleep 60
	done

}

function stop() { 
	PID=$(    cat /tmp/ipv64-ddns-update.pid)
	kill -9 "$PID"
	rm /tmp/ipv64-ddns-update.pid
	exit
}

function check() {
	
	log "Script wird gestartet" "SCRIPT"
	log "Das Script läuft unter der PID: $$" "SCRIPT"	
	log "Das Debian Paket läuft in der Version  $SCRIPTVERSION auf den Server" "SCRIPT"
	CheckDATEN
	main
}

function PROGRAMMABLAUF() {
if [ "$#" == 1 ];then
	case $1 in
	-set)
	  	set
	;;
	-stop)
	  	stop
	;;
	-run)
	  	run
	;;
	--check)
		check
	;;
	--version)
		echo "$SCRIPTVERSION"
	;;
	*)
		clear
		log "Fehlerhafte Eingabe" "SCRIPT"
	esac
else
	clear
	log "Fehlerhafte Eingabe" "SCRIPT"
fi
}

PROGRAMMABLAUF "${@}"
exit $?
